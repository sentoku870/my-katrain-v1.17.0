#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:self_atari"
msgstr "Self-atari warnings"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:self_atari_desc"
msgstr ""
"Warn when playing a move that places your own group in atari (a move that "
"loses a liberty)."

#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:ignore_atari"
msgstr "Ignored atari"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:ignore_atari_desc"
msgstr ""
"Warn when a move does not address a group already in atari (overlooks an "
"urgent save)."

#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:missed_capture"
msgstr "Missed capture"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:missed_capture_desc"
msgstr "Warn when a move could have captured opponent stones but did not."

#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:cut_risk"
msgstr "Cut risk"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:cut_risk_desc"
msgstr "Warn when a move exposes your groups to a cut (separation) threat."

#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:low_liberties"
msgstr "Low liberties"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:low_liberties_desc"
msgstr ""
"Warn when a group has very few liberties left and is in tactical danger."

#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:self_capture_like"
msgstr "Life and death"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:self_capture_like_desc"
msgstr ""
"Warn when a move involves the life-and-death of a group (semai / nakade)."

#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:bad_shape"
msgstr "Bad shape"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:bad_shape_desc"
msgstr "Warn when a move results in an inefficient or weak shape."

#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:heavy_group"
msgstr "Heavy group"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:heavy_group_desc"
msgstr ""
"Warn when your stones have become heavy (inefficient and lacking eyes)."

#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:missed_defense"
msgstr "Missed defense"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:missed_defense_desc"
msgstr ""
"Warn when your stones' connection is weak and the move misses a defensive "
"response."

#. Phase 251: per-category hint toggle label
msgid "mykatrain:settings:urgent_vs_big"
msgstr "Urgent vs big"

#. Phase 251: per-category hint toggle description
msgid "mykatrain:settings:urgent_vs_big_desc"
msgstr "Warn when a bigger or more urgent move exists elsewhere on the board."
