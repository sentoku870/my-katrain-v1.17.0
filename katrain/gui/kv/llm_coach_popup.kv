#:kivy 2.3.0
#:import i18n katrain.gui.lang_bridge.i18n
#:import Theme katrain.gui.theme.Theme
#:import dp kivy.metrics.dp

# Phase 225.3: LLM Coach popup body widget.
#
# Layout rules:
# - All action buttons share equal width via size_hint_x: 0.5 in two-column
#   BoxLayouts. This avoids the AutoSizedRoundedRectangleButton text-width
#   drift that made "プロンプト生成 & コピー" wrap awkwardly in Phase 225.0.
# - The response input uses a multiline LabelledTextInput with size_hint_y
#   to occupy the middle band; result label sits below in a ScrollView so
#   long Markdown reports stay scrollable without growing the popup.
# - The popup itself remains a single BoxLayout column; everything is
#   `size_hint_y: None` for the fixed rows and `size_hint_y: <fraction>`
#   for the elastic ones.

<LLMCcoachPopupContent>:
    orientation: 'vertical'
    padding: dp(10)
    spacing: dp(6)
    size_hint: 1, 1

    # Row 1: Karte JSON path + Browse button (75 / 25 split)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(48)
        spacing: dp(6)

        LabelledTextInput:
            id: karte_path_input
            hint_text: i18n._("mykatrain:llm-coach:karte-hint")
            multiline: False
            write_tab: False
            font_size: sp(14)
            size_hint_x: 0.75

        AutoSizedRoundedRectangleButton:
            id: browse_button
            text: i18n._("mykatrain:llm-coach:browse")
            size_hint_x: 0.25
            on_release: root.on_browse_karte()

    # Row 2: Rank input
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(48)
        spacing: dp(6)

        Label:
            text: i18n._("mykatrain:llm-coach:rank-label")
            size_hint_x: None
            width: dp(110)
            font_name: Theme.DEFAULT_FONT
            font_size: sp(13)
            halign: 'left'
            text_size: self.size

        LabelledTextInput:
            id: rank_input
            hint_text: "5k"
            multiline: False
            write_tab: False
            font_size: sp(13)
            size_hint_x: 1

    # Row 3: Action 1 — generate / clear (50/50)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(40)
        spacing: dp(6)

        AutoSizedRoundedRectangleButton:
            id: generate_button
            text: i18n._("mykatrain:llm-coach:build-prompt")
            size_hint_x: 0.5
            on_release: root.on_generate_and_copy()

        AutoSizedRoundedRectangleButton:
            id: clear_button
            text: i18n._("mykatrain:llm-coach:clear-response")
            size_hint_x: 0.5
            on_release: root.on_clear_response()

    # Row 4: Response input (multiline, fixed band)
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: 0.32
        spacing: dp(4)

        Label:
            text: i18n._("mykatrain:llm-coach:response-label")
            size_hint_y: None
            height: dp(18)
            font_name: Theme.DEFAULT_FONT
            font_size: sp(11)
            halign: 'left'
            text_size: self.size

        LabelledTextInput:
            id: response_input
            multiline: True
            write_tab: False
            font_size: sp(12)

    # Row 5: Action 2 — validate / copy result (50/50)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(40)
        spacing: dp(6)

        AutoSizedRoundedRectangleButton:
            id: validate_button
            text: i18n._("mykatrain:llm-coach:validate")
            size_hint_x: 0.5
            on_release: root.on_validate()

        AutoSizedRoundedRectangleButton:
            id: copy_result_button
            text: i18n._("mykatrain:llm-coach:copy-result")
            size_hint_x: 0.5
            on_release: root.on_copy_result()

    # Row 6: Status line (single line)
    Label:
        id: status_label
        text: root.status_text
        size_hint_y: None
        height: dp(20)
        font_name: Theme.DEFAULT_FONT
        font_size: sp(11)
        halign: 'left'
        text_size: self.size
        shorten: True

    # Row 7: Result label header
    Label:
        text: i18n._("mykatrain:llm-coach:result-label")
        size_hint_y: None
        height: dp(18)
        font_name: Theme.DEFAULT_FONT
        font_size: sp(11)
        halign: 'left'
        text_size: self.size

    # Row 8: Result label scrollable area
    ScrollView:
        size_hint_y: 0.68
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(6)

        Label:
            id: result_label
            text: ""
            font_name: Theme.DEFAULT_FONT
            font_size: sp(11)
            halign: 'left'
            valign: 'top'
            size_hint_y: None
            text_size: self.width, None
            height: self.texture_size[1] + dp(8)
            padding: (dp(4), dp(4))