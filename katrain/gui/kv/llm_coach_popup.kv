#:kivy 2.3.0
#:import i18n katrain.gui.lang_bridge.i18n
#:import Theme katrain.gui.theme.Theme
#:import dp kivy.metrics.dp

# Phase 225.4: LLM Coach popup body widget.
# Phase 225.6: added rank auto-hint label and perspective selector.

<LLMCcoachPopupContent>:
    orientation: 'vertical'
    padding: dp(10)
    spacing: dp(6)
    size_hint: 1, 1

    # Workflow hint at the top
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(64)
        padding: (dp(8), dp(6))
        canvas.before:
            Color:
                rgba: Theme.BOX_BACKGROUND_COLOR
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: i18n._("mykatrain:llm-coach:workflow-hint")
            font_name: Theme.DEFAULT_FONT
            font_size: sp(11)
            halign: 'left'
            valign: 'top'
            text_size: self.size
            color: Theme.TEXT_COLOR
            shorten: False

    # Row 1: Karte JSON path + Browse button (75/25 split)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(48)
        spacing: dp(6)

        LabelledTextInput:
            id: karte_path_input
            hint_text: i18n._("mykatrain:llm-coach:karte-hint")
            multiline: False
            write_tab: False
            font_size: sp(14)
            size_hint_x: 0.75

        SizedRoundedRectangleButton:
            id: browse_button
            text: i18n._("mykatrain:llm-coach:browse")
            size_hint_x: 0.25
            height: dp(40)
            on_release: root.on_browse_karte()

    # Row 2: Rank input + auto-detected hint label
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(48)
        spacing: dp(6)

        Label:
            text: i18n._("mykatrain:llm-coach:rank-label")
            size_hint_x: None
            width: dp(80)
            font_name: Theme.DEFAULT_FONT
            font_size: sp(13)
            halign: 'left'
            text_size: self.size

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 1
            spacing: dp(0)

            LabelledTextInput:
                id: rank_input
                hint_text: "5k"
                multiline: False
                write_tab: False
                font_size: sp(13)
                size_hint_y: None
                height: dp(34)

            Label:
                id: rank_auto_label
                text: ""
                font_name: Theme.DEFAULT_FONT
                font_size: sp(9)
                halign: 'left'
                text_size: self.size
                color: Theme.TEXT_COLOR

    # Row 3: Perspective selector (Auto / Black / White)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(48)
        spacing: dp(6)

        Label:
            text: i18n._("mykatrain:llm-coach:perspective-label")
            size_hint_x: None
            width: dp(80)
            font_name: Theme.DEFAULT_FONT
            font_size: sp(13)
            halign: 'left'
            text_size: self.size

        Spinner:
            id: perspective_select
            text: i18n._("mykatrain:llm-coach:perspective-auto")
            values:
                [
                i18n._("mykatrain:llm-coach:perspective-auto"),
                i18n._("mykatrain:llm-coach:perspective-black"),
                i18n._("mykatrain:llm-coach:perspective-white"),
                ]
            size_hint_x: 1
            height: dp(36)
            font_name: Theme.DEFAULT_FONT
            font_size: sp(13)
            on_text: root.on_perspective_changed()

    # Auto-detected perspective hint
    Label:
        id: perspective_auto_label
        text: ""
        size_hint_y: None
        height: dp(16)
        font_name: Theme.DEFAULT_FONT
        font_size: sp(9)
        halign: 'left'
        text_size: self.size
        color: Theme.TEXT_COLOR

    # Row 4: Action 1 — generate / clear (50/50)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(44)
        spacing: dp(6)

        SizedRoundedRectangleButton:
            id: generate_button
            text: i18n._("mykatrain:llm-coach:build-prompt")
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.on_generate_and_copy()

        SizedRoundedRectangleButton:
            id: clear_button
            text: i18n._("mykatrain:llm-coach:clear-response")
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.on_clear_response()

    # Row 5: Response input (multiline, fixed band)
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: 0.30
        spacing: dp(4)

        Label:
            text: i18n._("mykatrain:llm-coach:response-label")
            size_hint_y: None
            height: dp(18)
            font_name: Theme.DEFAULT_FONT
            font_size: sp(11)
            halign: 'left'
            text_size: self.size

        LabelledTextInput:
            id: response_input
            multiline: True
            write_tab: False
            font_size: sp(12)

    # Row 6: Action 2 — validate / copy result (50/50)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(44)
        spacing: dp(6)

        SizedRoundedRectangleButton:
            id: validate_button
            text: i18n._("mykatrain:llm-coach:validate")
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.on_validate()

        SizedRoundedRectangleButton:
            id: copy_result_button
            text: i18n._("mykatrain:llm-coach:copy-result")
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.on_copy_result()

    # Row 7: Status line (single line)
    Label:
        id: status_label
        text: root.status_text
        size_hint_y: None
        height: dp(20)
        font_name: Theme.DEFAULT_FONT
        font_size: sp(11)
        halign: 'left'
        text_size: self.size
        shorten: True

    # Row 8: Result label header
    Label:
        text: i18n._("mykatrain:llm-coach:result-label")
        size_hint_y: None
        height: dp(18)
        font_name: Theme.DEFAULT_FONT
        font_size: sp(11)
        halign: 'left'
        text_size: self.size

    # Row 9: Result label scrollable area
    ScrollView:
        size_hint_y: 0.66
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(6)

        Label:
            id: result_label
            text: ""
            font_name: Theme.DEFAULT_FONT
            font_size: sp(11)
            halign: 'left'
            valign: 'top'
            size_hint_y: None
            text_size: self.width, None
            height: self.texture_size[1] + dp(8)
            padding: (dp(4), dp(4))