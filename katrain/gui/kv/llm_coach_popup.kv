#:kivy 2.3.0
#:import i18n katrain.gui.lang_bridge.i18n
#:import Theme katrain.gui.theme.Theme
#:import dp kivy.metrics.dp

# Phase 225.7: LLM Coach popup body widget.
#
# Layout fixes vs Phase 225.6:
#   1. Rank input + Perspective spinner in the SAME row (50/50 split)
#      so the popup is shorter and wider.
#   2. Response input is now inside a ScrollView so long pasted text
#      scrolls instead of overflowing the popup.
#   3. Action buttons have explicit ``height`` and the response area
#      has a hard ``min_height`` so the buttons never overlap the label.
#   4. All auto-detection hints are stacked under their respective
#      input field, not floating in space.
#   5. Wider popup (900dp) per user feedback.

<LLMCoachPopupContent>:
    orientation: 'vertical'
    padding: dp(10)
    spacing: dp(6)
    size_hint: 1, 1

    # Workflow hint at the top
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(56)
        padding: (dp(8), dp(4))
        canvas.before:
            Color:
                rgba: Theme.BOX_BACKGROUND_COLOR
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: i18n._("mykatrain:llm-coach:workflow-hint")
            font_name: Theme.DEFAULT_FONT
            font_size: sp(11)
            halign: 'left'
            valign: 'top'
            text_size: self.size
            color: Theme.TEXT_COLOR
            shorten: False

    # Row 1: Karte JSON path + Browse button (75/25 split)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(48)
        spacing: dp(6)

        LabelledTextInput:
            id: karte_path_input
            hint_text: i18n._("mykatrain:llm-coach:karte-hint")
            multiline: False
            write_tab: False
            font_size: sp(13)
            size_hint_x: 0.78
            on_text_validate: root.on_path_changed()

        SizedRoundedRectangleButton:
            id: browse_button
            text: i18n._("mykatrain:llm-coach:browse")
            size_hint_x: 0.22
            height: dp(40)
            on_release: root.on_browse_karte()

    # Row 1b: Type label (single karte / multi-game summary / unknown)
    # Phase 227-D: shows the detected JSON type so the user knows which
    # mode the popup is in. Hidden until a path is set.
    # Phase 242-B: also shows the schema_version as a small suffix
    # (e.g. "単局カルテ · Schema 3.4") for debugging context.
    Label:
        id: type_label
        text: ""
        size_hint_y: None
        height: dp(20)
        font_name: Theme.DEFAULT_FONT
        font_size: sp(11)
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        color: Theme.TEXT_COLOR
        shorten: True

    # Row 2: Rank + Perspective in one row (50/50 split)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(64)
        spacing: dp(6)

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.5
            spacing: dp(0)

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(34)
                spacing: dp(4)

                Label:
                    text: i18n._("mykatrain:llm-coach:rank-label")
                    size_hint_x: None
                    width: dp(60)
                    font_name: Theme.DEFAULT_FONT
                    font_size: sp(12)
                    halign: 'left'
                    text_size: self.size

                Spinner:
                    id: rank_input
                    text: "ADVANCED（三段〜五段）"
                    values: ["BEGINNER（入門〜10級）", "INTERMEDIATE（9級〜4級）", "DAN（3級〜二段）", "ADVANCED（三段〜五段）", "EXPERT（六段以上）"]
                    font_size: sp(13)
                    size_hint_x: 1

            Label:
                id: rank_auto_label
                text: ""
                font_name: Theme.DEFAULT_FONT
                font_size: sp(9)
                halign: 'left'
                text_size: self.size
                color: Theme.TEXT_COLOR
                size_hint_y: None
                height: dp(22)

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.5
            spacing: dp(0)

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(34)
                spacing: dp(4)

                Label:
                    text: i18n._("mykatrain:llm-coach:perspective-label")
                    size_hint_x: None
                    width: dp(60)
                    font_name: Theme.DEFAULT_FONT
                    font_size: sp(12)
                    halign: 'left'
                    text_size: self.size

                Spinner:
                    id: perspective_select
                    text: i18n._("mykatrain:llm-coach:perspective-auto")
                    values:
                        [
                        i18n._("mykatrain:llm-coach:perspective-auto"),
                        i18n._("mykatrain:llm-coach:perspective-black"),
                        i18n._("mykatrain:llm-coach:perspective-white"),
                        ]
                    size_hint_x: 1
                    height: dp(34)
                    font_name: Theme.DEFAULT_FONT
                    font_size: sp(12)
                    on_text: root.on_perspective_changed()

            Label:
                id: perspective_auto_label
                text: ""
                font_name: Theme.DEFAULT_FONT
                font_size: sp(9)
                halign: 'left'
                text_size: self.size
                color: Theme.TEXT_COLOR
                size_hint_y: None
                height: dp(22)

    # Row 3: Action 1 — generate / clear (50/50)
    # Phase 227-D: the generate_button text changes between
    #   "プロンプト生成 & コピー" (karte) and "集約サマリプロンプト" (summary)
    # based on the detected path type. The action handler also dispatches.
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(44)
        spacing: dp(6)

        SizedRoundedRectangleButton:
            id: generate_button
            text: i18n._("mykatrain:llm-coach:build-prompt")
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.on_generate_and_copy()

        SizedRoundedRectangleButton:
            id: clear_button
            text: i18n._("mykatrain:llm-coach:clear-response")
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.on_clear_response()

    # Row 4: Response input — label + ScrollView wrapping a multiline
    # LabelledTextInput so long pasted text scrolls inside a fixed box.
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(180)
        spacing: dp(2)

        Label:
            text: i18n._("mykatrain:llm-coach:response-label")
            size_hint_y: None
            height: dp(20)
            font_name: Theme.DEFAULT_FONT
            font_size: sp(11)
            halign: 'left'
            text_size: self.size

        ScrollView:
            size_hint_y: 1
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(6)

            LabelledTextInput:
                id: response_input
                multiline: True
                write_tab: False
                font_size: sp(12)
                size_hint_y: None
                height: dp(154)
                # Phase 242-B: cap paste size to prevent UI freeze from
                # a multi-megabyte LLM response. _on_response_text
                # truncates silently and surfaces a status warning.
                on_text: root._on_response_text(self.text)

    # Row 5: Action 2 — validate / copy result (50/50)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(44)
        spacing: dp(6)

        SizedRoundedRectangleButton:
            id: validate_button
            text: i18n._("mykatrain:llm-coach:validate")
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.on_validate()

        SizedRoundedRectangleButton:
            id: copy_result_button
            text: i18n._("mykatrain:llm-coach:copy-result")
            size_hint_x: 0.5
            height: dp(40)
            on_release: root.on_copy_result()

    # Row 6: Status line (single line)
    Label:
        id: status_label
        text: root.status_text
        size_hint_y: None
        height: dp(22)
        font_name: Theme.DEFAULT_FONT
        font_size: sp(11)
        halign: 'left'
        text_size: self.size
        shorten: True

    # Row 7: Result label header
    Label:
        text: i18n._("mykatrain:llm-coach:result-label")
        size_hint_y: None
        height: dp(20)
        font_name: Theme.DEFAULT_FONT
        font_size: sp(11)
        halign: 'left'
        text_size: self.size

    # Row 8: Result label scrollable area
    ScrollView:
        size_hint_y: 1
        do_scroll_x: False
        do_scroll_y: True
        bar_width: dp(6)

        Label:
            id: result_label
            text: ""
            font_name: Theme.DEFAULT_FONT
            font_size: sp(11)
            halign: 'left'
            valign: 'top'
            size_hint_y: None
            text_size: self.width, None
            height: self.texture_size[1] + dp(8)
            padding: (dp(4), dp(4))