#:kivy 2.3.0
#:import i18n katrain.gui.lang_bridge.i18n
#:import kivy_version kivy.__version__
#:import Theme katrain.gui.theme.Theme

<LabelledTextInput>:
    # Phase 280: KivyMD 1.2.0 の ``line`` モードでは下線が ``self.y + dp(16)`` 固定位置に描かれ、
    # デフォルト padding ``[0, 16dp, 0, 10dp]`` のテキストコンテンツ領域を貫通する。
    # NotoSansJP のラテン文字ディセンダが大きいと、フィールドの下線とパス文字列が
    # 視覚的に重なり文字が読みにくくなる (``config_popup`` / ``llm_coach_popup`` で報告)。
    # ``rectangle`` モードは下線非描画・フィールド周囲枠線のみで
    # テキスト領域と視覚要素が重ならない。すべての ``LabelledTextInput`` 派生
    # (``LabelledPathInput`` / ``LabelledFloatInput`` / ``LabelledIntInput``) にも
    # 自動で伝播する。
    mode: "rectangle"
    font_name: Theme.DEFAULT_FONT
    font_size: sp(Theme.INPUT_FONT_SIZE)
    # Phase 280: フォーク元 v1.18.1 スタイル再現のためのコンパクト化。
    # - ``height: dp(36)`` + ``padding: [12, 8, 12, 8]`` で 1 行入力欄を
    #   Windows / Mac 標準の 28-36dp レンジに収める
    # - ``background_color: [0, 0, 0, 0]`` で TextInput デフォルトの白背景
    #   (通常 [1, 1, 1, 1]) を透明化し、popup のダーク背景と同化させる
    #   → これが「枠が大きすぎる」問題の主原因
    # - カーソル可視性: ダーク背景で sp(1) 白カーソルは完全に隠れるため、
    #   ``cursor_width: sp(2.5)`` + ``cursor_color: [0, 0, 0, 1]`` (黒)
    #   で、高 DPI 環境でも確実に視認できるようにする。
    #   フォーク元 v1.18.1 スクリーンショットでも薄い黒カーソルが見える。
    height: dp(36)
    size_hint_y: None
    padding: [dp(12), dp(8), dp(12), dp(8)]
    background_color: [0, 0, 0, 0]
    cursor_width: sp(2.5)
    # Phase 280: テキスト/カーソル/無効色は常に白。フォーカスによる
    # ``theme_cls.primary_color`` (青) フォールバックを全パターンで防ぐ。
    # ユーザー要望: カーソルは白 (``[1, 1, 1, 1]``) で統一。BOX_BACKGROUND_COLOR
    # (やや明るい紺) とのコントラストで 2.5sp 幅の縦線として視認可能。
    foreground_color: Theme.TEXT_COLOR
    disabled_foreground_color: Theme.TEXT_COLOR
    cursor_color: [1, 1, 1, 1]
    text_color_focus: Theme.TEXT_COLOR
    text_color_normal: Theme.TEXT_COLOR
    # Phase 280: 選択ハイライトを完全透明化。``setattr`` だと KivyMD 1.2.0
    # 内部の上書きロジック ``set_default_colors`` (``_set_color``) が
    # テーマ更新時に ``theme_cls.primary_color`` (青) に戻してしまうため、
    # ``on_focus`` バインディング (``self.selection_color = ...``) では
    # 反映漏れが起きた。代わりに ``fbind`` を使って ``selection_color``
    # プロパティを ``[0, 0, 0, 0]`` に永続的に固定する。
    selection_color: [0, 0, 0, 0]
    on_focus:
        self.foreground_color = Theme.TEXT_COLOR
        self.cursor_color = [1, 1, 1, 1]
        self.selection_color = [0, 0, 0, 0]
        self.text_color_focus = Theme.TEXT_COLOR
        self.text_color_normal = Theme.TEXT_COLOR
    # Phase 277: KivyMD 1.2.0 removed ``helper_text_mode: "none"`` and
    # ``color_mode``. ``helper_text: ""`` keeps the helper line empty
    # under the new ``on_focus`` default, which is the equivalent of
    # the old ``"none"`` behaviour.
    hint_text: ""
    helper_text: ""
    line_color_focus: Theme.TEXT_COLOR
    line_color_normal: [0.5, 0.5, 0.5, 1]
    line_color: [0.5, 0.5, 0.5, 1]
    text_color: Theme.TEXT_COLOR
    hint_text_color: [0.6, 0.6, 0.6, 1]

<LabelledPathInput>:
    font_name: Theme.DEFAULT_FONT
    font_size: sp(16)
    multiline: False
    write_tab: False
    helper_text_mode: "on_error"
    helper_text: i18n._("file not found")

<LabelledIntInput>:
    font_size: sp(Theme.INPUT_FONT_SIZE)
    write_tab: False
    size_hint: 0.5, None
    # Phase 280: sp(20) フォント用に LabelledTextInput ベースの dp(36) だと
    # テキストが切れるため dp(40) に拡張
    height: dp(40)

<LabelledFloatInput>:
    font_size: sp(Theme.INPUT_FONT_SIZE)
    write_tab: False
    size_hint: 0.5, None
    # Phase 280: sp(20) フォント用に LabelledTextInput ベースの dp(36) だと
    # テキストが切れるため dp(40) に拡張
    height: dp(40)

<LabelledCheckBox>:
    size: sp(Theme.DESC_FONT_SIZE)*2,sp(Theme.DESC_FONT_SIZE)*2
    size_hint: None,None

<QuickInputButton@SizedRectangleButton>
    on_left_press: if self.target: self.target.text = self.text
    size: sp(Theme.DESC_FONT_SIZE) * 2, sp(Theme.DESC_FONT_SIZE) * 2
    # Phase 283: with default size_hint=(1, 1), a parent MDBoxLayout
    # (used in NewGamePopup's quick-input rows) does not include these
    # 36x36 sp buttons in its minimum_width / minimum_height because
    # BoxLayout only counts children with size_hint_*=None. The result
    # is a 0-width MDBoxLayout and zero-sized buttons — entirely
    # invisible. Setting size_hint to None on the button itself makes
    # MDBoxLayout respect the explicit size in its minimum dimensions.
    size_hint: None, None
    font_size: sp(Theme.DESC_FONT_SIZE)

<I18NPopup>:
    background_color: Theme.BACKGROUND_COLOR
    background: self.background if kivy_version < '2.0' else ''
    title: i18n._(self.title_key)
    title_size: sp(Theme.DESC_FONT_SIZE)
    title_font: self.font_name
    size_hint: None, None

<QuickConfigGui>:
    orientation: 'vertical'
    spacing: Theme.CP_SPACING
    padding: 4*Theme.CP_PADDING,Theme.CP_PADDING, 4*Theme.CP_PADDING, Theme.CP_PADDING

<DescriptionLabel>:
    font_size: sp(Theme.DESC_FONT_SIZE)
    multiline: True
    text_size: self.width, None
    halign: 'center'
    valign: 'center'

<SmallDescriptionLabel@DescriptionLabel>
    font_size: sp(Theme.DESC_FONT_SIZE) * 0.66

<ConfigSectionGridLayout@MDGridLayout+BackgroundMixin>:
    padding: Theme.CP_PADDING/2
    spacing: Theme.CP_SMALL_SPACING
    background_color: Theme.BOX_BACKGROUND_COLOR
