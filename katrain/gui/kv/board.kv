#:kivy 2.3.0
#:import i18n katrain.gui.lang_bridge.i18n
#:import Theme katrain.gui.theme.Theme
#:import BLACK katrain.gui.theme.BLACK
#:import STATUS_INFO katrain.core.constants.STATUS_INFO
#:import TooltipMixin katrain.gui.kivyutils.mixins.TooltipMixin

<BadukPanWidget>:
    size: self.parent.height, self.parent.height
    katrain: app.gui

# Phase 287-F: NavIconButton mixes in TooltipMixin so the tooltip_text
# property turns into a 500ms long-press popup. The TooltipMixin lives
# in katrain.gui.kivyutils.mixins and is re-exported via __init__.
<NavIconButton@TransparentIconButton+TooltipMixin>:
    size_hint: 0.06, 0.4
    icon_size: [min(self.size[0],self.height),min(self.size[0],self.height)]
    pos_hint: {'center_y': 0.5}

# Phase 287-F: a small vertical layout that pairs a NavIconButton with
# a short text caption underneath. The class is defined in Python
# (katrain.gui.widgets.nav_icon_caption) so Kivy can resolve
# root.caption_text / root.tooltip_text / root.icon / root.color via
# the Kivy property bindings declared there. The wrapper keeps the
# same size_hint_x as the bare icon button so the 8-cell row layout
# below still aligns. The icon button carries a tooltip_text that the
# TooltipMixin turns into a long-press popup.
<NavIconButtonWithCaption>:
    orientation: 'vertical'
    spacing: 2
    padding: 0
    NavIconButton:
        id: icon_btn
        icon: root.icon
        color: root.color
        size_hint_y: 0.6
        tooltip_text: root.tooltip_text
        on_press: root.dispatch('on_press')
    Label:
        id: caption_label
        text: root.caption_text
        size_hint_y: 0.4
        # Phase 287-G (this fix): sp(10) + shorten/1-line on a 2500x1440
        # display collapses JP captions like 「前のミス」「10手戻る」into
        # unreadable stubs. Bump the font, give the label more vertical
        # room, and let the text wrap to two lines so it always shows
        # the full caption. Pin the font to Theme.DEFAULT_FONT so it
        # doesn't fall back to Roboto (which lacks JP glyphs and
        # renders blank on the user-facing language).
        font_size: sp(11)
        font_name: Theme.DEFAULT_FONT
        color: Theme.TEXT_COLOR
        halign: 'center'
        valign: 'middle'
        shorten: True
        max_lines: 2

<BadukPanControls>:
    katrain: app.gui
    circles: [black_circle,white_circle]
    mid_circles_container: mid_circles_container
    pass_btn: pass_btn
    sgf_button: sgf_button
    adaptive_height: True
    AutoSizedRoundedRectangleButton:
        id: sgf_button
        text: 'SGF'
        size_hint: None, 0.5
        pos_hint: {'center_x': 0.08,'center_y':0.5}
        on_release: root.katrain("open-recent-sgf")
    AutoSizedRoundedRectangleButton:
        id: pass_btn
        text: i18n._('pass-button-text')
        size_hint: None, 0.5
        pos_hint: {'center_x': 0.15,'center_y':0.5}
        on_left_release: root.katrain("play",None)
    AutoSizedRoundedRectangleButton:
        id: black_focus_btn
        text: i18n._('focus:black')
        size_hint: None, 0.5
        pos_hint: {'center_x': 0.22,'center_y':0.5}
        on_release: app.gui.ctx.analysis_controller.set_analysis_focus_toggle("black")
    AutoSizedRoundedRectangleButton:
        id: white_focus_btn
        text: i18n._('focus:white')
        size_hint: None, 0.5
        pos_hint: {'center_x': 0.29,'center_y':0.5}
        on_release: app.gui.ctx.analysis_controller.set_analysis_focus_toggle("white")
    BoxLayout:
        size_hint: None, 1
        width: 8 * self.height
        pos_hint: {'center_x': 0.5,'center_y':0.5}
        Label:
            size_hint: 0.075, 0.5
        NavIconButtonWithCaption:
            icon: 'Previous-Mistake.png'
            color: Theme.MISTAKE_BUTTON_COLOR
            caption_text: i18n._('ui:caption:prev-mistake')
            tooltip_text: i18n._('ui:tooltip:prev-mistake')
            on_press: root.katrain('find-mistake','undo')
        NavIconButtonWithCaption:
            icon: 'Previous-End.png'
            caption_text: i18n._('ui:caption:first')
            tooltip_text: i18n._('ui:tooltip:first-move')
            on_press: root.katrain('undo',9999)
        NavIconButtonWithCaption:
            icon: 'Previous-5.png'
            caption_text: i18n._('ui:caption:prev-10')
            tooltip_text: i18n._('ui:tooltip:prev-10')
            on_press: root.katrain('undo',10)
        NavIconButtonWithCaption:
            icon: 'Previous.png'
            caption_text: i18n._('ui:caption:prev-1')
            tooltip_text: i18n._('ui:tooltip:prev-1')
            on_press: root.katrain('undo')
        MDFloatLayout:
            size_hint: 0.05, 1
            id: mid_circles_container
            CircleWithText:
                size_hint: 5/8, 1
                pos_hint: {'center_x': 0.5-3/16}
                id: black_circle
                player: 'B'
                text: ''
            CircleWithText:
                size_hint: 5/8, 1
                pos_hint: {'center_x': 0.5+3/16}
                id: white_circle
                player: 'W'
                text: ''
        NavIconButtonWithCaption:
            icon: 'Next.png'
            caption_text: i18n._('ui:caption:next-1')
            tooltip_text: i18n._('ui:tooltip:next-1')
            on_press: root.katrain('redo')
        NavIconButtonWithCaption:
            icon: 'Next-5.png'
            caption_text: i18n._('ui:caption:next-10')
            tooltip_text: i18n._('ui:tooltip:next-10')
            on_press: root.katrain('redo',10)
        NavIconButtonWithCaption:
            icon: 'Next-End.png'
            caption_text: i18n._('ui:caption:last')
            tooltip_text: i18n._('ui:tooltip:last-move')
            on_press: root.katrain('redo',9999)
        NavIconButtonWithCaption:
            icon: 'Next-Mistake.png'
            color: Theme.MISTAKE_BUTTON_COLOR
            caption_text: i18n._('ui:caption:next-mistake')
            tooltip_text: i18n._('ui:tooltip:next-mistake')
            on_press: root.katrain('find-mistake','redo')
        NavIconButtonWithCaption:
            icon: 'Rotate.png'
            caption_text: i18n._('ui:caption:rotate')
            tooltip_text: i18n._('ui:tooltip:rotate')
            on_press: root.katrain('rotate')
    ClickableLabel:
        pos_hint: {'center_x': 0.85,'center_y':0.5}
        size_hint: None, 1
        width: self.height
        canvas.before:
            Color:
                rgba: Theme.ENGINE_PONDERING_COLOR
            Ellipse:
                pos: self.pos[0] + self.width/2 - self.width/6, self.pos[1]  + self.height/2  - self.width/6
                size: self.width/3, self.width/3
            Color:
                rgba: root.engine_status_col
            Ellipse:
                angle_start: 0 if root.engine_status_pondering==-1 else root.engine_status_pondering % 360
                angle_end: 360 if root.engine_status_pondering==-1 else (root.engine_status_pondering  % 360 + 180)
                pos: self.pos[0] + self.width/2 - self.width/6, self.pos[1]  + self.height/2  - self.width/6
                size: self.width/3, self.width/3
            Color:
                rgba: BLACK
            Line:
                circle: self.pos[0] + self.width/2, self.pos[1] + self.height/2, self.width/6
                width: 1
        text: str(root.queries_remaining) if root.queries_remaining >= 3 else ''
        color: BLACK
        font_size: 0.5 * self.width / max(2,len(self.text))
        on_press: app.gui.controls.set_status(i18n._('ai-ponder'),STATUS_INFO)
