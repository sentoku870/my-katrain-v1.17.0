# Phase 248-γ-D1: Important-moves list popup layout.
#
# Layout:
#   Header (game name + level + count)
#   ScrollView:
#     RecycleView of ImportantMovesEntry rows
#   Footer (jump / copy / close buttons)
#
# The widget is defined in
# ``katrain/gui/popups/important_moves_popup.py``
# as ``ImportantMovesPopupContent``.


<ImportantMovesEntry@BoxLayout>:
    move_number: 0
    player: ""
    gtp_coord: ""
    score_loss: 0.0
    meaning_tag_label: ""
    complexity_discounted: False
    is_current: False
    bg_color: [0, 0, 0, 0]
    font_name: Theme.DEFAULT_FONT
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(36)
    padding: [dp(8), dp(2)]
    canvas:
        Color:
            rgba: root.bg_color
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: f'#{root.move_number}'
        size_hint_x: None
        width: dp(40)
        font_size: sp(13)
        font_name: root.font_name
        color: Theme.TEXT_COLOR
    Label:
        text: root.player
        size_hint_x: None
        width: dp(28)
        font_size: sp(13)
        font_name: root.font_name
        color: Theme.TEXT_COLOR if root.player != 'B' else [0.1, 0.4, 0.9, 1]
    Label:
        text: root.gtp_coord
        size_hint_x: None
        width: dp(56)
        font_size: sp(13)
        font_name: root.font_name
        color: Theme.TEXT_COLOR
    Label:
        text: f'{root.score_loss:.1f}目'
        size_hint_x: None
        width: dp(64)
        font_size: sp(13)
        font_name: root.font_name
        color: Theme.TEXT_COLOR
    Label:
        text: root.meaning_tag_label + (' (複雑)' if root.complexity_discounted else '')
        font_size: sp(12)
        font_name: root.font_name
        color: Theme.TEXT_COLOR
        text_size: self.size
        halign: 'left'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'


<ImportantMovesPopupContent>:
    orientation: 'vertical'
    padding: [dp(12), dp(8)]
    spacing: dp(8)
    size_hint: 1, 1

    # ---- Header ----
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(60)
        spacing: dp(2)
        Label:
            id: header_game_name
            text: ''
            font_size: sp(14)
            font_name: root.font_name
            color: Theme.TEXT_COLOR
            bold: True
            size_hint_y: None
            height: dp(22)
            text_size: self.size
            halign: 'left'
            valign: 'middle'
        Label:
            id: header_meta
            text: ''
            font_size: sp(12)
            font_name: root.font_name
            color: Theme.TEXT_COLOR
            size_hint_y: None
            height: dp(18)
            text_size: self.size
            halign: 'left'
            valign: 'middle'
        Label:
            id: header_count
            text: ''
            font_size: sp(12)
            font_name: root.font_name
            color: Theme.TEXT_COLOR
            size_hint_y: None
            height: dp(18)
            text_size: self.size
            halign: 'left'
            valign: 'middle'

    # ---- Empty-state placeholder (shown when there are no moves) ----
    Label:
        id: empty_label
        text: i18n._('mykatrain:popup:important-moves:empty')
        font_size: sp(13)
        font_name: root.font_name
        color: Theme.TEXT_COLOR
        opacity: 0
        size_hint_y: None
        height: dp(0)

    # ---- Scrollable list of entries ----
    ScrollView:
        id: scroll_view
        size_hint: 1, 1
        do_scroll_x: False
        do_scroll_y: True
        BoxLayout:
            id: entries_box
            orientation: 'vertical'
            size_hint_y: None
            height: max(self.minimum_height, scroll_view.height)
            spacing: dp(1)

    # ---- Footer buttons ----
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(40)
        spacing: dp(8)
        Button:
            id: jump_button
            text: i18n._('mykatrain:popup:important-moves:jump')
            font_name: root.font_name
            size_hint_x: 0.4
            disabled: True
            on_release: root.on_jump()
        Button:
            id: copy_button
            text: i18n._('mykatrain:popup:important-moves:copy')
            font_name: root.font_name
            size_hint_x: 0.3
            on_release: root.on_copy()
        Button:
            id: close_button
            text: i18n._('mykatrain:popup:important-moves:close')
            font_name: root.font_name
            size_hint_x: 0.3
            on_release: root.on_close()
